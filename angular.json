{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "RepoLens": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "root": "apps/desktop",
      "sourceRoot": "apps/desktop/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "apps/desktop/dist/renderer",
            "browser": "apps/desktop/src/main.ts",
            "index": "apps/desktop/src/index.html",
            "tsConfig": "apps/desktop/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/desktop/public"
              }
            ],
            "styles": ["apps/desktop/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "index": "apps/desktop/src/index.development.html",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "0.0.0.0",
            "port": 4200,
            "allowedHosts": [".e2b.app", "localhost", "127.0.0.1"]
          },
          "configurations": {
            "production": {
              "buildTarget": "RepoLens:build:production"
            },
            "development": {
              "buildTarget": "RepoLens:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/desktop/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
